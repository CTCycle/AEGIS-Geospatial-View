app/resources/vectors/**
app/client/node_modules/
app/client/dist/
app/client/dist-ssr/
app/client/logs/
assets/QA/**
.playwright-mcp/

# Environment files (keep templates)
settings/.env
app/client/*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
app/server/uv.lock

# Node / JS
**/node_modules/
**/dist/
**/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
**/package-lock.json
yarn.lock

# IDE / OS
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Misc
.tmp_logs/
*.lock
*.log

# Alembic and migration runtime artifacts
*.mako
*.migration-backup-*.db
*.migration.lock
*.db
*.db-shm
*.db-wal
*.sqlite*
*.exe

!.gitkeep

# Commit dependency lockfiles for reproducible CI installs.
!app/server/uv.lock
!app/client/package-lock.json
