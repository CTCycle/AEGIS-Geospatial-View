###############################################################################
# Server Runtime
###############################################################################
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=5002
UI_HOST=127.0.0.1
UI_PORT=5000
RELOAD=false

# Set to false to keep backend logs hidden; defaults to true when absent.
BACKEND_LOGS_VISIBLE=true

# Realtime WebSocket security. Keep missing-origin connections disabled in
# browser deployments; this is only useful for local non-browser test clients.
REALTIME_ALLOW_MISSING_ORIGIN=false

###############################################################################
# Database Mode
###############################################################################
EMBEDDED_DATABASE=true

###############################################################################
# External Database Connection
###############################################################################
DATABASE_URL=
DATABASE_ENGINE=postgresql+psycopg
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=AEGIS
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

###############################################################################
# External Database Security And Performance
###############################################################################
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_CONNECT_TIMEOUT=30
DATABASE_INSERT_BATCH_SIZE=1000
