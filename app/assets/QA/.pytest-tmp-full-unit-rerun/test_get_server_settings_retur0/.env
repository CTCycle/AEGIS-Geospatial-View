###############################################################################
# Server Runtime
###############################################################################
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=5002
UI_HOST=127.0.0.1
UI_PORT=5000
RELOAD=false

# Set to false to keep backend logs hidden; defaults to true when absent.
BACKEND_LOGS_VISIBLE=true

# Realtime WebSocket security. Keep missing-origin connections disabled in
# browser deployments; this is only useful for local non-browser test clients.
REALTIME_ALLOW_MISSING_ORIGIN=false

# Restricted public sources remain unavailable unless the deployment owner
# explicitly confirms that their use is eligible under the provider terms.
AEGIS_ALLOW_RESTRICTED_SOURCES=false

###############################################################################
# SQLite
###############################################################################
# Leave AEGIS_DATA_DIR empty to use app/resources/runtime/database.db.
AEGIS_DATA_DIR=
SQLITE_LOCK_TIMEOUT=60
