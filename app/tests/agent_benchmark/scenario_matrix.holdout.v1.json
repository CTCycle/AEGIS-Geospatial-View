  "scenarios": [
    {
      "id": "holdout-city-country-1",
      "lane": "model_in_loop",
      "prompt": "Put the map on Valparaiso, Chile.",
      "max_turn_seconds": 180,
      "dimensions": {"intent": "location_lookup", "dataset": "location", "geographic_scale": "city", "temporal": "current", "ambiguity": "none", "tool_count": "one", "availability": "supported", "conversation": "fresh"},
      "expected": {"task_classes": ["map_search"], "capability_families": ["location"], "clarification": "not_required", "minimum_tool_count": 1, "rendering_types": ["map", "point"], "provenance_required": true, "fabrication_forbidden": true},
      "assertions": ["one_location_tool", "rendered_map", "valid_arguments"],
      "invariants": ["context_usage_invariants", "location_target_consistency", "categorized_failures", "no_false_success", "deadline_compliance"]
    },
