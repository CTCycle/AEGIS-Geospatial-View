      "dimensions": {"intent": "weather_lookup", "dataset": "weather", "geographic_scale": "city", "temporal": "forecast", "ambiguity": "none", "tool_count": "one", "availability": "supported", "conversation": "fresh"},
      "expected": {"task_classes": ["direct_query", "map_search"], "capability_families": ["weather"], "clarification": "not_required", "minimum_tool_count": 1, "rendering_types": ["text", "map", "point"], "provenance_required": true, "fabrication_forbidden": true},
      "assertions": ["valid_arguments"]
    },
