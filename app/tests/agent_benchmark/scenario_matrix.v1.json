      "expected": {"task_classes": ["map_search", "unclear"], "capability_families": [], "clarification": "required", "minimum_tool_count": 0, "rendering_types": ["text", "none"], "provenance_required": false, "fabrication_forbidden": true},
      "assertions": ["clarification_or_context_resolution"]
