      "dimensions": {"intent": "environmental_layer", "dataset": "land_cover", "geographic_scale": "region", "temporal": "current", "ambiguity": "none", "tool_count": "one", "availability": "supported", "conversation": "fresh"},
      "expected": {"task_classes": ["map_search"], "capability_families": ["land_cover"], "clarification": "not_required", "minimum_tool_count": 1, "rendering_types": ["map", "raster"], "provenance_required": true, "fabrication_forbidden": true},
