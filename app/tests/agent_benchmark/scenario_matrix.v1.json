      "expected": {"task_classes": ["map_search", "direct_query"], "capability_families": ["weather"], "clarification": "not_required", "minimum_tool_count": 1, "rendering_types": ["map", "point", "text"], "provenance_required": true, "fabrication_forbidden": true},
      "assertions": ["rendered_map", "valid_arguments"]
    },
    {
      "id": "weather-forecast-city",
      "lane": "model_in_loop",
