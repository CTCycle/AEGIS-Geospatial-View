{
  "matrix_version": "1.0",
  "purpose": "Property-oriented evaluation of geographic interpretation, execution, provenance, and rendering across independent conversations.",
  "safety_invariants": {
    "provenance_required_for_retrieved_data": true,
    "fabricated_values_forbidden": true,
    "clarify_material_ambiguity": true,
    "invalid_geometry_fails_closed": true
  },
  "scenarios": [
    {
      "id": "location-city-fresh",
      "lane": "model_in_loop",
      "prompt": "Find Zurich on the map.",
      "dimensions": {"intent": "location_lookup", "dataset": "location", "geographic_scale": "city", "temporal": "current", "ambiguity": "none", "tool_count": "one", "availability": "supported", "conversation": "fresh"},
      "expected": {"task_classes": ["map_search"], "capability_families": ["location"], "clarification": "not_required", "minimum_tool_count": 1, "rendering_types": ["map", "point"], "provenance_required": true, "fabrication_forbidden": true},
      "assertions": ["one_location_tool", "rendered_map", "valid_arguments"]
    },
    {
      "id": "physical-elevation-coordinate",
      "lane": "model_in_loop",
      "prompt": "Show the elevation at 46.0037, 8.9511.",
      "dimensions": {"intent": "physical_measurement", "dataset": "elevation", "geographic_scale": "point", "temporal": "current", "ambiguity": "none", "tool_count": "one", "availability": "supported", "conversation": "fresh"},
      "expected": {"task_classes": ["map_search", "direct_query"], "capability_families": ["elevation"], "clarification": "not_required", "minimum_tool_count": 1, "rendering_types": ["map", "point", "text"], "provenance_required": true, "fabrication_forbidden": true},
      "assertions": ["valid_arguments"]
    },
    {
      "id": "physical-boundary-region",
      "lane": "model_in_loop",
      "prompt": "Show the geographic boundary of Canton Ticino.",
      "dimensions": {"intent": "boundary_lookup", "dataset": "geographic_boundaries", "geographic_scale": "region", "temporal": "current", "ambiguity": "none", "tool_count": "one", "availability": "supported", "conversation": "fresh"},
      "expected": {"task_classes": ["map_search"], "capability_families": ["boundaries"], "clarification": "not_required", "minimum_tool_count": 1, "rendering_types": ["map", "polygon"], "provenance_required": true, "fabrication_forbidden": true},
      "assertions": ["rendered_map", "valid_arguments"]
    },
    {
      "id": "weather-current-city",
      "lane": "model_in_loop",
      "prompt": "Show the current weather in Rome, Italy.",
