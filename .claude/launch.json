{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "cwd": "app",
      "runtimeExecutable": "server/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "server.app:app", "--host", "127.0.0.1", "--port", "7059", "--ws-max-size", "65536", "--ws-ping-interval", "15", "--ws-ping-timeout", "10"],
      "port": 7059
    },
    {
      "name": "frontend",
      "cwd": "app/client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "--host", "127.0.0.1", "--port", "4512"],
      "port": 4512
    }
  ]
}
